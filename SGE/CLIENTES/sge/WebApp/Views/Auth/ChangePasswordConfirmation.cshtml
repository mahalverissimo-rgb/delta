@{
    ViewData["Title"] = "Senha Alterada";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-md-6 offset-md-3">
            <div class="card">
                <div class="card-body">
                    <div class="alert alert-success" role="alert">
                        <h4 class="alert-heading">Senha Alterada!</h4>
                        <p>Sua senha foi alterada com sucesso.</p>
                        <hr>
                        <p class="mb-0">Você pode continuar usando o sistema normalmente.</p>
                    </div>

                    <div class="text-center mt-3">
                        <a asp-action="Index" asp-controller="Home" class="btn btn-primary">Voltar para o Início</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
