@{
    ViewData["Title"] = "Recuperação de Senha";
    Layout = "_LayoutAuth";
}

<div class="login-box">
    <div class="login-logo">
        <img src="~/images/logo.png" alt="Villa Bisutti" class="img-fluid" />
    </div>

    <div class="card">
        <div class="card-body login-card-body">
            <div class="alert alert-success" role="alert">
                <h4 class="alert-heading">Email Enviado!</h4>
                <p>Enviamos um email com instruções para recuperar sua senha.</p>
                <hr>
                <p class="mb-0">Verifique sua caixa de entrada e siga as instruções.</p>
            </div>

            <p class="mt-3 mb-1">
                <a asp-action="Login">Voltar para o login</a>
            </p>
        </div>
    </div>
</div>
