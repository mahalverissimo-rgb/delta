@{
    ViewData["Title"] = "Dashboard";
}

<div class="row">
    <div class="col-12 mb-4">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h2 class="m-0">Bem-vindo ao Sistema de Gestão</h2>
                        <p class="text-muted">Visualize e gerencie seus eventos de forma eficiente</p>
                    </div>
                    <div>
                        <a href="/Evento/Create" class="btn btn-primary"><i class="fas fa-plus"></i> Novo Evento</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Estatísticas Rápidas -->
<div class="row">
    <div class="col-lg-3 col-6">
        <div class="small-box bg-info">
            <div class="inner">
                <h3>@ViewBag.EventosCount</h3>
                <p>Eventos Ativos</p>
            </div>
            <div class="icon">
                <i class="fas fa-calendar-check"></i>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-success">
            <div class="inner">
                <h3>@ViewBag.LocaisCount</h3>
                <p>Locais Disponíveis</p>
            </div>
            <div class="icon">
                <i class="fas fa-map-marked-alt"></i>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-warning">
            <div class="inner">
                <h3>@ViewBag.CardapiosCount</h3>
                <p>Cardápios</p>
            </div>
            <div class="icon">
                <i class="fas fa-utensils"></i>
            </div>
        </div>
    </div>
    <div class="col-lg-3 col-6">
        <div class="small-box bg-danger">
            <div class="inner">
                <h3>@ViewBag.ServicosCount</h3>
                <p>Tipos de Serviço</p>
            </div>
            <div class="icon">
                <i class="fas fa-concierge-bell"></i>
            </div>
        </div>
    </div>
</div>

<!-- Acesso Rápido -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title"><i class="fas fa-star mr-2"></i> Acesso Rápido</h3>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 col-sm-6 col-12">
                        <a href="/Evento" class="text-decoration-none">
                            <div class="info-box">
                                <span class="info-box-icon bg-info"><i class="fas fa-calendar-alt"></i></span>
                                <div class="info-box-content">
                                    <span class="info-box-text">Eventos</span>
                                    <span class="info-box-number">Gerenciar</span>
                                </div>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-3 col-sm-6 col-12">
                        <a href="/Local" class="text-decoration-none">
                            <div class="info-box">
                                <span class="info-box-icon bg-success"><i class="fas fa-map-marker-alt"></i></span>
                                <div class="info-box-content">
                                    <span class="info-box-text">Locais</span>
                                    <span class="info-box-number">Gerenciar</span>
                                </div>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-3 col-sm-6 col-12">
                        <a href="/Cardapio" class="text-decoration-none">
                            <div class="info-box">
                                <span class="info-box-icon bg-warning"><i class="fas fa-utensils"></i></span>
                                <div class="info-box-content">
                                    <span class="info-box-text">Cardápios</span>
                                    <span class="info-box-number">Gerenciar</span>
                                </div>
                            </div>
                        </a>
                    </div>
                    <div class="col-md-3 col-sm-6 col-12">
                        <a href="/TipoServico" class="text-decoration-none">
                            <div class="info-box">
                                <span class="info-box-icon bg-danger"><i class="fas fa-concierge-bell"></i></span>
                                <div class="info-box-content">
                                    <span class="info-box-text">Serviços</span>
                                    <span class="info-box-number">Gerenciar</span>
                                </div>
                            </div>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Próximos Eventos -->
<div class="row">
    <div class="col-lg-8 col-md-12">
        <div class="card">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h3 class="card-title"><i class="fas fa-calendar-day mr-2"></i> Próximos Eventos</h3>
                    <button type="button" class="btn btn-sm btn-outline-primary" id="refreshEvents"><i class="fas fa-sync-alt"></i></button>
                </div>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Nome</th>
                            <th>Data</th>
                            <th>Local</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.ProximosEventos != null && ViewBag.ProximosEventos.Count > 0)
                        {
                            @foreach (var evento in ViewBag.ProximosEventos)
                            {
                                <tr>
                                    <td><a href="/Evento/Details/@evento.Id">@evento.Nome</a></td>
                                    <td>@evento.Data.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@evento.Local?.Nome</td>
                                    <td><span class="badge badge-success">Confirmado</span></td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center">Nenhum evento agendado</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer text-center">
                <a href="/Evento" class="btn btn-sm btn-primary">Ver todos os eventos</a>
            </div>
        </div>
    </div>
    
    <div class="col-lg-4 col-md-12">
        <div class="card">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center">
                    <h3 class="card-title"><i class="fas fa-chart-pie mr-2"></i> Resumo</h3>
                    <button type="button" class="btn btn-sm btn-outline-primary" id="refreshChart"><i class="fas fa-sync-alt"></i></button>
                </div>
            </div>
            <div class="card-body">
                <canvas id="donutChart" style="min-height: 250px; height: 250px; max-height: 250px; max-width: 100%;"></canvas>
                <!-- Campos ocultos para os valores das estatísticas -->
                <input type="hidden" id="eventosCount" value="@ViewBag.EventosCount" />
                <input type="hidden" id="locaisCount" value="@ViewBag.LocaisCount" />
                <input type="hidden" id="cardapiosCount" value="@ViewBag.CardapiosCount" />
                <input type="hidden" id="servicosCount" value="@ViewBag.ServicosCount" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Dashboard Scripts -->
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
