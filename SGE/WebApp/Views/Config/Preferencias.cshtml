@{
    ViewData["Title"] = "Preferências";
}

<div class="row">
    <div class="col-md-3">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Configurações</h3>
            </div>
            <div class="card-body p-0">
                <ul class="nav nav-pills flex-column">
                    <li class="nav-item">
                        <a href="/Config/Sistema" class="nav-link">
                            <i class="fas fa-cogs mr-2"></i> Sistema
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/Config/Perfil" class="nav-link">
                            <i class="fas fa-user mr-2"></i> Perfil
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/Config/Preferencias" class="nav-link active">
                            <i class="fas fa-sliders-h mr-2"></i> Preferências
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/Config/Seguranca" class="nav-link">
                            <i class="fas fa-shield-alt mr-2"></i> Segurança
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-md-9">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Preferências do Sistema</h3>
            </div>
            <div class="card-body">
                <form>
                    <div class="form-group">
                        <label>Tema</label>
                        <select class="form-control select2">
                            <option>Claro</option>
                            <option>Escuro</option>
                            <option>Auto</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Idioma</label>
                        <select class="form-control select2">
                            <option>Português</option>
                            <option>Inglês</option>
                            <option>Espanhol</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Formato de Data</label>
                        <select class="form-control select2">
                            <option>DD/MM/AAAA</option>
                            <option>MM/DD/AAAA</option>
                            <option>AAAA-MM-DD</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Fuso Horário</label>
                        <select class="form-control select2">
                            <option>Brasília (GMT-3)</option>
                            <option>UTC</option>
                            <option>Nova York (GMT-4)</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <div class="custom-control custom-switch">
                            <input type="checkbox" class="custom-control-input" id="notificacoesEmail">
                            <label class="custom-control-label" for="notificacoesEmail">Receber notificações por email</label>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary">Salvar</button>
                </form>
            </div>
        </div>
    </div>
</div>
