@{
    ViewData["Title"] = "Configurações do Sistema";
}

<div class="row">
    <div class="col-md-3">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Configurações</h3>
            </div>
            <div class="card-body p-0">
                <ul class="nav nav-pills flex-column">
                    <li class="nav-item">
                        <a href="/Config/Sistema" class="nav-link active">
                            <i class="fas fa-cogs mr-2"></i> Sistema
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/Config/Perfil" class="nav-link">
                            <i class="fas fa-user mr-2"></i> Perfil
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/Config/Preferencias" class="nav-link">
                            <i class="fas fa-sliders-h mr-2"></i> Preferências
                        </a>
                    </li>
                    <li class="nav-item">
                        <a href="/Config/Seguranca" class="nav-link">
                            <i class="fas fa-shield-alt mr-2"></i> Segurança
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </div>
    <div class="col-md-9">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Configurações do Sistema</h3>
            </div>
            <div class="card-body">
                <form>
                    <div class="form-group">
                        <label for="nomeEmpresa">Nome da Empresa</label>
                        <input type="text" class="form-control" id="nomeEmpresa" placeholder="Nome da Empresa">
                    </div>
                    <div class="form-group">
                        <label for="logoEmpresa">Logo da Empresa</label>
                        <div class="input-group">
                            <div class="custom-file">
                                <input type="file" class="custom-file-input" id="logoEmpresa">
                                <label class="custom-file-label" for="logoEmpresa">Escolher arquivo</label>
                            </div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label for="emailContato">Email de Contato</label>
                        <input type="email" class="form-control" id="emailContato" placeholder="Email de Contato">
                    </div>
                    <div class="form-group">
                        <label for="telefoneContato">Telefone de Contato</label>
                        <input type="text" class="form-control" id="telefoneContato" placeholder="Telefone de Contato">
                    </div>
                    <button type="submit" class="btn btn-primary">Salvar</button>
                </form>
            </div>
        </div>
    </div>
</div>
