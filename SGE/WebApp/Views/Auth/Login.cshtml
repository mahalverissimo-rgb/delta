@model SGE.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = "_LayoutAuth";
}

<div class="login-box">
    <div class="card">
        <div class="card-body login-card-body">
            <p class="login-box-msg">Entre com seu e-mail e senha</p>

            <form asp-action="Login" method="post">
                <div asp-validation-summary="All" class="text-danger"></div>
                <input type="hidden" asp-for="ReturnUrl" />

                <div class="input-group mb-3">
                    <input asp-for="Email" class="form-control" placeholder="Email">
                    <div class="input-group-append">
                        <div class="input-group-text">
                            <span class="fas fa-envelope"></span>
                        </div>
                    </div>
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="input-group mb-3">
                    <input asp-for="Password" class="form-control" placeholder="Senha">
                    <div class="input-group-append">
                        <div class="input-group-text">
                            <span class="fas fa-lock"></span>
                        </div>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="row">
                    <div class="col-8">
                        <div class="icheck-primary">
                            <input type="checkbox" asp-for="RememberMe" id="remember">
                            <label for="remember">Lembrar-me</label>
                        </div>
                    </div>
                    <div class="col-4">
                        <button type="submit" class="btn btn-primary btn-block">Entrar</button>
                    </div>
                </div>
            </form>

            <div class="social-auth-links text-center mb-3">
                <p>- OU -</p>
                <form asp-action="ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <button type="submit" name="provider" value="Google" class="btn btn-block btn-danger">
                        <i class="fab fa-google mr-2"></i> Entrar com Google
                    </button>
                    <button type="submit" name="provider" value="Microsoft" class="btn btn-block btn-light">
                        <i class="fab fa-microsoft mr-2"></i> Entrar com Microsoft
                    </button>
                    <button type="submit" name="provider" value="Facebook" class="btn btn-block btn-primary">
                        <i class="fab fa-facebook mr-2"></i> Entrar com Facebook
                    </button>
                </form>
            </div>

            <p class="mb-1">
                <a asp-action="ForgotPassword">Esqueci minha senha</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
