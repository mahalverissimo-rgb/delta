@model SGE.Models.Evento
@using SGE.Models.Enums

@{
    ViewData["Title"] = "Novo Evento";
}

<div class="container-fluid">
    <div class="card card-outline card-primary">
        <div class="card-header">
            <h3 class="card-title">@ViewData["Title"]</h3>
            <div class="card-tools">
                <button type="button" class="btn btn-tool" data-card-widget="collapse">
                    <i class="fas fa-minus"></i>
                </button>
            </div>
        </div>
        <div class="card-body">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="card card-info">
                            <div class="card-header">
                                <h3 class="card-title"><i class="fas fa-info-circle mr-2"></i>Dados Principais</h3>
                            </div>
                            <div class="card-body">
                                <div class="form-group">
                                    <label asp-for="Nome" class="control-label">Nome do Evento</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text"><i class="fas fa-tag"></i></span>
                                        </div>
                                        <input asp-for="Nome" class="form-control" placeholder="Nome do evento (opcional)" />
                                    </div>
                                    <span asp-validation-for="Nome" class="text-danger"></span>
                                    <small class="form-text text-muted">Se não for informado, será gerado automaticamente.</small>
                                </div>

                                <div class="form-group">
                                    <label asp-for="TipoEvento" class="control-label"></label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text"><i class="fas fa-calendar-day"></i></span>
                                        </div>
                                        <select asp-for="TipoEvento" asp-items="Html.GetEnumSelectList<TipoEvento>()" class="form-control select2">
                                            <option value="">Selecione...</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="TipoEvento" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="LocalId" class="control-label"></label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text"><i class="fas fa-map-marker-alt"></i></span>
                                        </div>
                                        <select asp-for="LocalId" class="form-control select2" asp-items="ViewBag.Locais">
                                            <option value="">Selecione...</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="LocalId" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="CardapioId" class="control-label"></label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text"><i class="fas fa-utensils"></i></span>
                                        </div>
                                        <select asp-for="CardapioId" class="form-control select2" asp-items="ViewBag.Cardapios">
                                            <option value="">Selecione...</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="CardapioId" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="TipoServicoId" class="control-label"></label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text"><i class="fas fa-concierge-bell"></i></span>
                                        </div>
                                        <select asp-for="TipoServicoId" class="form-control select2" asp-items="ViewBag.TiposServico">
                                            <option value="">Selecione...</option>
                                        </select>
                                    </div>
                                    <span asp-validation-for="TipoServicoId" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="Data" class="control-label"></label>
                                    <div class="input-group date" id="datepicker" data-target-input="nearest">
                                        <div class="input-group-prepend" data-target="#datepicker">
                                            <span class="input-group-text"><i class="fas fa-calendar"></i></span>
                                        </div>
                                        <input asp-for="Data" type="date" class="form-control" />
                                    </div>
                                    <span asp-validation-for="Data" class="text-danger"></span>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="HorarioInicio" class="control-label"></label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="fas fa-clock"></i></span>
                                                </div>
                                                <input asp-for="HorarioInicio" class="form-control time-mask" placeholder="00:00" />
                                            </div>
                                            <span asp-validation-for="HorarioInicio" class="text-danger"></span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <label asp-for="HorarioTermino" class="control-label"></label>
                                            <div class="input-group">
                                                <div class="input-group-prepend">
                                                    <span class="input-group-text"><i class="fas fa-clock"></i></span>
                                                </div>
                                                <input asp-for="HorarioTermino" class="form-control time-mask" placeholder="00:00" />
                                            </div>
                                            <span asp-validation-for="HorarioTermino" class="text-danger"></span>
                                        </div>
                                    </div>
                                </div>

                                <div class="form-group">
                                    <label asp-for="Pax" class="control-label"></label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text"><i class="fas fa-users"></i></span>
                                        </div>
                                        <input asp-for="Pax" class="form-control" type="number" min="1" placeholder="Número de convidados" />
                                        <div class="input-group-append">
                                            <span class="input-group-text">pessoas</span>
                                        </div>
                                    </div>
                                    <span asp-validation-for="Pax" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="card card-success">
                            <div class="card-header">
                                <h3 class="card-title"><i class="fas fa-user mr-2"></i>Dados do Responsável</h3>
                            </div>
                            <div class="card-body">
                                <div class="form-group">
                                    <label asp-for="NomeResponsavel" class="control-label"></label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text"><i class="fas fa-user"></i></span>
                                        </div>
                                        <input asp-for="NomeResponsavel" class="form-control" placeholder="Nome completo" />
                                    </div>
                                    <span asp-validation-for="NomeResponsavel" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="EmailResponsavel" class="control-label"></label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                        </div>
                                        <input asp-for="EmailResponsavel" class="form-control" type="email" placeholder="email@exemplo.com" />
                                    </div>
                                    <span asp-validation-for="EmailResponsavel" class="text-danger"></span>
                                </div>

                                <div class="form-group">
                                    <label asp-for="TelefoneResponsavel" class="control-label"></label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text"><i class="fas fa-phone"></i></span>
                                        </div>
                                        <input asp-for="TelefoneResponsavel" class="form-control phone-mask" placeholder="(00) 00000-0000" />
                                    </div>
                                    <span asp-validation-for="TelefoneResponsavel" class="text-danger"></span>
                                </div>

                                <div class="form-group mt-4">
                                    <div class="custom-control custom-switch">
                                        <input asp-for="PossuiAssessoria" class="custom-control-input" />
                                        <label asp-for="PossuiAssessoria" class="custom-control-label"></label>
                                    </div>
                                </div>

                                <div class="form-group" id="assessoriaGroup" style="display:none;">
                                    <label asp-for="ContatoAssessoria" class="control-label"></label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text"><i class="fas fa-id-badge"></i></span>
                                        </div>
                                        <input asp-for="ContatoAssessoria" class="form-control" placeholder="Nome e contato da assessoria" />
                                    </div>
                                    <span asp-validation-for="ContatoAssessoria" class="text-danger"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mt-4">
                    <div class="card-body bg-light">
                        <div class="row">
                            <div class="col-md-6 text-left">
                                <a asp-action="Index" class="btn btn-secondary btn-lg">
                                    <i class="fas fa-arrow-left mr-2"></i> Voltar para a lista
                                </a>
                            </div>
                            <div class="col-md-6 text-right">
                                <button type="submit" class="btn btn-success btn-lg">
                                    <i class="fas fa-save mr-2"></i> Salvar Evento
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            // Inicializar Select2 para melhorar a experiência de seleção
            $('.select2').select2({
                theme: 'bootstrap4',
                width: '100%'
            });
            
            // Máscaras para formatação de entrada
            $('.time-mask').mask('00:00');
            $('.phone-mask').mask('(00) 00000-0000');

            // Toggle campo de assessoria
            $('#PossuiAssessoria').change(function() {
                $('#assessoriaGroup').toggle(this.checked);
            });
            
            // Verificar estado inicial do checkbox de assessoria
            if ($('#PossuiAssessoria').is(':checked')) {
                $('#assessoriaGroup').show();
            }
            
            // Inicializar tooltips
            $('[data-toggle="tooltip"]').tooltip();
        });
    </script>
}
