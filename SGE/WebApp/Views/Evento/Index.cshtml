@model IEnumerable<SGE.Models.Evento>

@{
    ViewData["Title"] = "Eventos";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-6">
            <a asp-action="Create" class="btn btn-primary">
                <i class="fas fa-plus"></i> Novo Evento
            </a>
        </div>
        <div class="col-md-6">
            <div class="input-group">
                <input type="text" id="eventSearch" class="form-control" placeholder="Buscar eventos...">
                <div class="input-group-append">
                    <button class="btn btn-default">
                        <i class="fas fa-search"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div class="card card-outline card-primary">
        <div class="card-header">
            <h3 class="card-title">Lista de Eventos</h3>
            <div class="card-tools">
                <button type="button" class="btn btn-tool" data-card-widget="collapse">
                    <i class="fas fa-minus"></i>
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover" id="eventsTable">
                    <thead class="thead-light">
                        <tr>
                            <th>@Html.DisplayNameFor(model => model.Nome)</th>
                            <th>@Html.DisplayNameFor(model => model.Data)</th>
                            <th>@Html.DisplayNameFor(model => model.TipoEvento)</th>
                            <th>@Html.DisplayNameFor(model => model.Local)</th>
                            <th>@Html.DisplayNameFor(model => model.NomeResponsavel)</th>
                            <th>@Html.DisplayNameFor(model => model.Pax)</th>
                            <th style="width: 120px;">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td><strong>@Html.DisplayFor(modelItem => item.Nome)</strong></td>
                            <td>@item.Data.ToString("dd/MM/yyyy")</td>
                            <td>
                                <span class="badge @(item.TipoEvento.ToString() == "Casamento" ? "badge-info" : 
                                                 item.TipoEvento.ToString() == "Corporativo" ? "badge-primary" : 
                                                 item.TipoEvento.ToString() == "Aniversario" ? "badge-success" : 
                                                 "badge-secondary")">@item.TipoEvento</span>
                            </td>
                            <td>@(item.Local != null ? item.Local.Nome : "Não definido")</td>
                            <td>@Html.DisplayFor(modelItem => item.NomeResponsavel)</td>
                            <td>@Html.DisplayFor(modelItem => item.Pax) pessoas</td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Editar" data-toggle="tooltip">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Detalhes" data-toggle="tooltip">
                                        <i class="fas fa-info-circle"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Excluir" data-toggle="tooltip">
                                        <i class="fas fa-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Inicializar DataTable com opções avançadas
            var table = $('#eventsTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Portuguese-Brasil.json"
                },
                "responsive": true,
                "lengthMenu": [[10, 25, 50, -1], [10, 25, 50, "Todos"]],
                "pageLength": 10,
                "order": [[ 1, "desc" ]],  // Ordenar por data decrescente
                "columnDefs": [
                    { "orderable": false, "targets": 6 }  // Desabilitar ordenação na coluna de ações
                ],
                "dom": '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>' +
                       '<"row"<"col-sm-12"tr>>' +
                       '<"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>'
            });
            
            // Conectar a barra de busca personalizada ao DataTable
            $('#eventSearch').keyup(function() {
                table.search($(this).val()).draw();
            });
            
            // Inicializar tooltips
            $('[data-toggle="tooltip"]').tooltip();
            
            // Destacar linha ao passar o mouse
            $('#eventsTable tbody').on('mouseenter', 'tr', function() {
                $(this).addClass('bg-light');
            }).on('mouseleave', 'tr', function() {
                $(this).removeClass('bg-light');
            });
        });
    </script>
}
