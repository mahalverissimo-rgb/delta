@model SGE.Models.Evento

@{
    ViewData["Title"] = "Excluir Evento";
}

<div class="container-fluid">
    <h1 class="mt-4">@ViewData["Title"]</h1>

    <div class="alert alert-danger" role="alert">
        <h4 class="alert-heading">Atenção!</h4>
        <p>Você tem certeza que deseja excluir este evento? Esta ação não poderá ser desfeita.</p>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h4>Dados Principais</h4>
                    <hr />
                    
                    <dl class="row">
                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.TipoEvento)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.TipoEvento)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Local)</dt>
                        <dd class="col-sm-8">@(Model.Local != null ? Model.Local.Nome : "")</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Data)</dt>
                        <dd class="col-sm-8">@Model.Data.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Pax)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Pax)</dd>
                    </dl>
                </div>

                <div class="col-md-6">
                    <h4>Dados do Responsável</h4>
                    <hr />

                    <dl class="row">
                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.NomeResponsavel)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.NomeResponsavel)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.EmailResponsavel)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.EmailResponsavel)</dd>

                        <dt class="col-sm-4">@Html.DisplayNameFor(model => model.TelefoneResponsavel)</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.TelefoneResponsavel)</dd>
                    </dl>
                </div>
            </div>

            <form asp-action="Delete" class="mt-4">
                <input type="hidden" asp-for="Id" />
                <input type="submit" value="Excluir" class="btn btn-danger" />
                <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
            </form>
        </div>
    </div>
</div>
