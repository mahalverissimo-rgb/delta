@model SGE.Models.Local

@{
    ViewData["Title"] = "Novo Local";
}

<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card card-primary card-outline">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-map-marker-alt mr-2"></i>Novo Local</h3>
                    </div>
                    <form asp-action="Create">
                        <div class="card-body">
                            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                            
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="card card-info">
                                        <div class="card-header">
                                            <h3 class="card-title"><i class="fas fa-info-circle mr-2"></i>Dados Principais</h3>
                                        </div>
                                        <div class="card-body">
                                            <div class="form-group">
                                                <label asp-for="Nome" class="control-label"></label>
                                                <div class="input-group">
                                                    <div class="input-group-prepend">
                                                        <span class="input-group-text"><i class="fas fa-building"></i></span>
                                                    </div>
                                                    <input asp-for="Nome" class="form-control" placeholder="Nome do local" />
                                                </div>
                                                <span asp-validation-for="Nome" class="text-danger"></span>
                                            </div>
                                            
                                            <div class="form-group">
                                                <label asp-for="Endereco" class="control-label"></label>
                                                <div class="input-group">
                                                    <div class="input-group-prepend">
                                                        <span class="input-group-text"><i class="fas fa-map-marked-alt"></i></span>
                                                    </div>
                                                    <input asp-for="Endereco" class="form-control" placeholder="Endereço completo" />
                                                </div>
                                                <span asp-validation-for="Endereco" class="text-danger"></span>
                                            </div>
                                            
                                            <div class="form-group">
                                                <label asp-for="Capacidade" class="control-label"></label>
                                                <div class="input-group">
                                                    <div class="input-group-prepend">
                                                        <span class="input-group-text"><i class="fas fa-users"></i></span>
                                                    </div>
                                                    <input asp-for="Capacidade" class="form-control" type="number" min="1" placeholder="Capacidade de pessoas" />
                                                    <div class="input-group-append">
                                                        <span class="input-group-text">pessoas</span>
                                                    </div>
                                                </div>
                                                <span asp-validation-for="Capacidade" class="text-danger"></span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <div class="col-md-6">
                                    <div class="card card-success">
                                        <div class="card-header">
                                            <h3 class="card-title"><i class="fas fa-clipboard-list mr-2"></i>Informações Adicionais</h3>
                                        </div>
                                        <div class="card-body">
                                            <div class="form-group">
                                                <label asp-for="Observacoes" class="control-label"></label>
                                                <div class="input-group">
                                                    <div class="input-group-prepend">
                                                        <span class="input-group-text"><i class="fas fa-sticky-note"></i></span>
                                                    </div>
                                                    <textarea asp-for="Observacoes" class="form-control" rows="5" placeholder="Informações adicionais sobre o local"></textarea>
                                                </div>
                                                <span asp-validation-for="Observacoes" class="text-danger"></span>
                                            </div>
                                            
                                            <div class="form-group mt-4">
                                                <div class="custom-control custom-switch">
                                                    <input class="custom-control-input" asp-for="Ativo" />
                                                    <label class="custom-control-label" asp-for="Ativo"></label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        
                        <div class="card mt-4">
                            <div class="card-body bg-light">
                                <div class="row">
                                    <div class="col-md-6 text-left">
                                        <a asp-action="Index" class="btn btn-secondary btn-lg">
                                            <i class="fas fa-arrow-left mr-2"></i> Voltar para a lista
                                        </a>
                                    </div>
                                    <div class="col-md-6 text-right">
                                        <button type="submit" class="btn btn-success btn-lg">
                                            <i class="fas fa-save mr-2"></i> Salvar Local
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            // Inicializar tooltips
            $('[data-toggle="tooltip"]').tooltip();
        });
    </script>
}
