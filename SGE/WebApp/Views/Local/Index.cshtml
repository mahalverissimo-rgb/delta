@model IEnumerable<SGE.Models.Local>

@{
    ViewData["Title"] = "Locais";
}

<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="card card-primary card-outline">
                    <div class="card-header">
                        <h3 class="card-title"><i class="fas fa-map-marker-alt mr-2"></i> Locais</h3>
                        <div class="card-tools">
                            <div class="input-group input-group-sm" style="width: 250px;">
                                <input type="text" id="tableSearch" class="form-control float-right" placeholder="Pesquisar local...">
                                <div class="input-group-append">
                                    <button type="button" class="btn btn-default"><i class="fas fa-search"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="card-header bg-light">
                        <a asp-action="Create" class="btn btn-success">
                            <i class="fas fa-plus mr-1"></i> Novo Local
                        </a>
                    </div>
                    <div class="card-body">
                        <table id="locaisTable" class="table table-bordered table-striped table-hover">
                            <thead class="thead-light">
                                <tr>
                                    <th>@Html.DisplayNameFor(model => model.Nome)</th>
                                    <th>@Html.DisplayNameFor(model => model.Endereco)</th>
                                    <th>@Html.DisplayNameFor(model => model.Capacidade)</th>
                                    <th>@Html.DisplayNameFor(model => model.Ativo)</th>
                                    <th style="width: 120px;">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td><strong>@Html.DisplayFor(modelItem => item.Nome)</strong></td>
                                        <td>@Html.DisplayFor(modelItem => item.Endereco)</td>
                                        <td>@item.Capacidade pessoas</td>
                                        <td>
                                            @if (item.Ativo)
                                            {
                                                <span class="badge badge-success">Ativo</span>
                                            }
                                            else
                                            {
                                                <span class="badge badge-danger">Inativo</span>
                                            }
                                        </td>
                                        <td>
                                            <div class="btn-group" role="group">
                                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Editar" data-toggle="tooltip">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Detalhes" data-toggle="tooltip">
                                                    <i class="fas fa-info-circle"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Excluir" data-toggle="tooltip">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            // Inicializar DataTable
            var table = $('#locaisTable').DataTable({
                "responsive": true,
                "autoWidth": false,
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Portuguese-Brasil.json"
                },
                "columnDefs": [
                    { "orderable": false, "targets": 4 } // Desabilitar ordenação na coluna de ações
                ]
            });

            // Implementar pesquisa personalizada
            $('#tableSearch').keyup(function () {
                table.search($(this).val()).draw();
            });

            // Inicializar tooltips
            $('[data-toggle="tooltip"]').tooltip();
        });
    </script>
}
