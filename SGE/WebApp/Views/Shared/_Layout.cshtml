<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @CompanySettings.GetSettings().Name</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/icheck-bootstrap/icheck-bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/select2/css/select2.min.css" />
    <link rel="stylesheet" href="~/lib/select2-bootstrap4-theme/select2-bootstrap4.min.css" />
    <link rel="stylesheet" href="~/lib/datatables-bs4/css/dataTables.bootstrap4.min.css" />
    <link rel="stylesheet" href="~/lib/datatables-responsive/css/responsive.bootstrap4.min.css" />
    <link rel="stylesheet" href="~/css/adminlte.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Google Font: Source Sans Pro -->
    <link href="https://fonts.googleapis.com/css?family=Source+Sans+Pro:300,400,400i,700" rel="stylesheet">
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">
        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <!-- Left navbar links -->
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>
            </ul>

            <!-- Right navbar links -->
            <ul class="navbar-nav ml-auto">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <!-- Email do usuário -->
                    <li class="nav-item d-none d-sm-inline-block mr-3">
                        <span class="nav-link"><i class="fas fa-envelope mr-1"></i>@User.Identity.Name</span>
                    </li>
                    
                    <!-- Menu do usuário -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <i class="fas fa-user-circle"></i>
                        </a>
                        <div class="dropdown-menu dropdown-menu-right" aria-labelledby="navbarDropdown">
                            <a class="dropdown-item" href="/Perfil">
                                <i class="fas fa-user mr-2"></i> Meu Perfil
                            </a>
                            <a class="dropdown-item" asp-controller="Auth" asp-action="ChangePassword">
                                <i class="fas fa-key mr-2"></i> Alterar Senha
                            </a>
                            <a class="dropdown-item" href="/Config">
                                <i class="fas fa-cogs mr-2"></i> Configurações
                            </a>
                            <div class="dropdown-divider"></div>
                            <form asp-controller="Auth" asp-action="Logout" method="post">
                                <button type="submit" class="dropdown-item">
                                    <i class="fas fa-sign-out-alt mr-2"></i> Sair
                                </button>
                            </form>
                        </div>
                    </li>
                }
            </ul>
        </nav>

        <!-- Main Sidebar Container -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">
            <!-- Brand Logo -->
            <a href="/" class="brand-link">
                <img src="@CompanySettings.GetSettings().Logo" alt="Logo" class="brand-image img-circle elevation-3" style="opacity: .8; max-height: 30px; width: auto;">
                <span class="brand-text font-weight-light">Gestão de Eventos</span>
            </a>

            <!-- Sidebar -->
            <div class="sidebar">
                <!-- Sidebar Menu -->
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" data-widget="treeview" role="menu" data-accordion="false">
                        <li class="nav-item">
                            <a href="/" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")">
                                <i class="nav-icon fas fa-tachometer-alt"></i>
                                <p>Dashboard</p>
                            </a>
                        </li>
                        
                        <!-- Menu Sistema com todos os itens agrupados -->
                        <li class="nav-item has-treeview @(new[] {"Evento", "Local", "Cardapio", "TipoServico", "Config"}.Contains(ViewContext.RouteData.Values["controller"]?.ToString()) ? "menu-open" : "")">
                            <a href="#" class="nav-link @(new[] {"Evento", "Local", "Cardapio", "TipoServico", "Config"}.Contains(ViewContext.RouteData.Values["controller"]?.ToString()) ? "active" : "")">
                                <i class="nav-icon fas fa-th"></i>
                                <p>
                                    Sistema
                                    <i class="fas fa-angle-left right"></i>
                                </p>
                            </a>
                            <ul class="nav nav-treeview">
                                <li class="nav-item">
                                    <a href="/Evento" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Evento" ? "active" : "")">
                                        <i class="fas fa-calendar-alt nav-icon"></i>
                                        <p>Eventos</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="/Local" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Local" ? "active" : "")">
                                        <i class="fas fa-map-marker-alt nav-icon"></i>
                                        <p>Locais</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="/Cardapio" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cardapio" ? "active" : "")">
                                        <i class="fas fa-utensils nav-icon"></i>
                                        <p>Cardápios</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="/TipoServico" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "TipoServico" ? "active" : "")">
                                        <i class="fas fa-concierge-bell nav-icon"></i>
                                        <p>Tipos de Serviço</p>
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a href="/Config" class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Config" ? "active" : "")">
                                        <i class="fas fa-cogs nav-icon"></i>
                                        <p>Configurações</p>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Content Wrapper. Contains page content -->
        <div class="content-wrapper">
            <!-- Content Header (Page header) -->
            <div class="content-header">
                <div class="container-fluid">
                    <div class="row mb-2">
                        <div class="col-sm-6">
                            <h1 class="m-0">@ViewData["Title"]</h1>
                        </div>
                    </div>
                </div>
            </div>
            <!-- Main content -->
            <section class="content">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </section>
        </div>

        <!-- Main Footer -->
        <footer class="main-footer">
            <strong>Copyright &copy; @DateTime.Now.Year <a href="#">SGE - Sistema de Gerenciamento de Eventos</a>.</strong>
            Todos os direitos reservados.
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-mask/jquery.mask.min.js"></script>
    <script src="~/lib/select2/js/select2.full.min.js"></script>
    <script src="~/lib/datatables/jquery.dataTables.min.js"></script>
    <script src="~/lib/datatables-bs4/js/dataTables.bootstrap4.min.js"></script>
    <script src="~/lib/datatables-responsive/js/dataTables.responsive.min.js"></script>
    <script src="~/lib/datatables-responsive/js/responsive.bootstrap4.min.js"></script>
    <script src="~/lib/adminlte/js/adminlte.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        $(document).ready(function() {
            // Inicializar tooltips
            $('[data-toggle="tooltip"]').tooltip();
            
            // Inicializar Select2 para todos os selects com classe select2
            $('.select2').select2({
                theme: 'bootstrap4',
                width: '100%'
            });
            
            // Inicializar DataTables para todas as tabelas com classe datatable
            $('.datatable').DataTable({
                "responsive": true,
                "autoWidth": false,
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Portuguese-Brasil.json"
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
