@model VillaBisutti.Delta.WebApp.Models.Cardapio

@{
    ViewData["Title"] = "Detalhes do Cardápio";
}

<div class="content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-md-12">
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">Detalhes do Cardápio</h3>
                    </div>
                    <div class="card-body">
                        <dl class="row">
                            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Nome)</dt>
                            <dd class="col-sm-10">@Html.DisplayFor(model => model.Nome)</dd>

                            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Descricao)</dt>
                            <dd class="col-sm-10">@Html.DisplayFor(model => model.Descricao)</dd>

                            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.PrecoPorPessoa)</dt>
                            <dd class="col-sm-10">@Html.DisplayFor(model => model.PrecoPorPessoa)</dd>

                            <dt class="col-sm-2">@Html.DisplayNameFor(model => model.Ativo)</dt>
                            <dd class="col-sm-10">@Html.DisplayFor(model => model.Ativo)</dd>
                        </dl>
                    </div>
                    <div class="card-footer">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-info">Editar</a>
                        <a asp-action="Index" class="btn btn-default">Voltar</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
